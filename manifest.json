{
  "manifest_version": 3,
  "name": "TikDownload",
  "version": "1.0.1",
  "description": "Download TikTok and Douyin videos/images with one click.",
  "permissions": ["storage", "downloads", "webRequest"],
  "host_permissions": ["*://*.tiktok.com/*", "*://*.douyin.com/*", "*://*.douyinvod.com/*", "*://*.tiktokcdn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*", "*://*.douyin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "matches": ["*://*.douyin.com/*", "*://*.tiktok.com/*"],
      "resources": ["fetcher.js"]
    }
  ]
}
